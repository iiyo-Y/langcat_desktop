# Desktop 本地开发环境变量
# 复制为 .env.local 后再 pnpm dev / pnpm build
# .env.local 不入 git

# LangCat 后端 API 基址。vite.config.ts 在 build 时把它 inline 到 main 进程 bundle。
# - 本机开发:http://localhost:8080(api-go 默认端口)
# - 生产:之后部署后改成 https://api.langcat.your-domain.com
VITE_LANGCAT_API_BASE_URL=http://localhost:8080

# Supabase 认证(桌面 app 登录)。两个值跟 langcat_web 的 NEXT_PUBLIC_SUPABASE_*
# 同源 —— 同一个 Supabase 项目,两端共用同一套用户表(auth.users)。
# Publishable / Anon key 是公开的,安全靠 Postgres RLS。
VITE_LANGCAT_SUPABASE_URL=https://your-project.supabase.co
VITE_LANGCAT_SUPABASE_ANON_KEY=eyJhbGciOiJI...
