{
  "name": "langcat-desktop",
  "version": "0.1.0",
  "description": "LangCat 桌面端 — 跨平台(macOS / Windows / Linux)单词学习工具,第一步:hover 单词显示释义",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iiyo-Y/langcat_desktop.git"
  },
  "scripts": {
    "dev": "vite",
    "build": "pnpm typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json --noEmit",
    "package:mac": "pnpm build && electron-builder --mac --config electron-builder.yml",
    "package:win": "pnpm build && electron-builder --win --config electron-builder.yml",
    "package:linux": "pnpm build && electron-builder --linux --config electron-builder.yml",
    "package:all": "pnpm build && electron-builder -mwl --config electron-builder.yml",
    "release": "node scripts/release.mjs"
  },
  "dependencies": {
    "@nut-tree-fork/nut-js": "^4.2.6",
    "electron-updater": "^6.3.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.28.0",
    "postcss": "^8.5.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6"
  },
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild",
      "@nut-tree-fork/libnut",
      "@nut-tree-fork/libnut-darwin",
      "@nut-tree-fork/libnut-linux",
      "@nut-tree-fork/libnut-win32"
    ]
  }
}
